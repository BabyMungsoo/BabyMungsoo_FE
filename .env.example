# 실제 값은 .env.local 에 넣습니다 (.env.local 은 git 에 올라가지 않습니다)
#
# 비워두면 Expo 개발 서버의 호스트를 그대로 재사용해 http://<개발PC IP>:8080/api/v1 로 붙습니다.
# (src/api/client.ts 참고 — 실기기/에뮬레이터 모두 별도 설정 없이 동작합니다)
#
# 배포 서버가 생기면 아래 값을 채워주세요.
EXPO_PUBLIC_API_BASE_URL=

# 백엔드가 로컬이 아닌 포트를 쓰면 변경 (기본 8080)
EXPO_PUBLIC_API_PORT=8080

# 로그인이 붙기 전까지 GET /records?userId= 에 넣을 개발용 사용자 ID (기본 1)
# 로그인 구현 후에는 src/stores/use-session-store.ts 에서 제거하면 됩니다.
EXPO_PUBLIC_DEV_USER_ID=1

# 9번 병원 찾기의 카카오맵 JS SDK 키.
# 카카오 developers > 내 애플리케이션 > 앱 키 > 'JavaScript 키' 입니다.
# (백엔드가 쓰는 REST API 키와 다른 값이니 주의)
EXPO_PUBLIC_KAKAO_JS_KEY=

# 카카오는 지도를 요청한 도메인이 등록되어 있는지 확인합니다.
# 카카오 developers > 앱 설정 > 플랫폼 > Web 에 아래 값을 사이트 도메인으로 등록해 주세요.
# 앱(WebView)은 로컬 HTML 이라 도메인이 없어서 이 값을 대신 알려주고, 웹은 실제로 이 주소로 뜹니다.
# 비워두면 http://localhost:8081 (Expo 웹 개발 서버 기본 주소)을 씁니다.
EXPO_PUBLIC_KAKAO_WEB_ORIGIN=

# 개발용 위치 고정 ('위도,경도'). 병원 데이터가 서울에만 있어서
# 서울 밖에서는 실제 위치로 열면 결과가 늘 비어 있습니다.
# 값이 있으면 기기 위치를 묻지 않고 여기를 현재 위치로 씁니다. (예: 서울시청 37.5665,126.978)
# 배포 전에는 반드시 비워 주세요.
EXPO_PUBLIC_DEV_LOCATION=
